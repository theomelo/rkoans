module Exercises
  class AboutScoringProject
    def self.score: (Array[Integer] dice) -> Integer
  end
end

class AboutScoringProjectTest
  def test_score_of_an_empty_list_is_zero: -> void
  def test_score_of_a_single_roll_of_5_is_50: -> void
  def test_score_of_a_single_roll_of_1_is_100: -> void
  def test_score_of_multiple_1s_and_5s_is_the_sum_of_individual_scores: -> void
  def test_score_of_single_2s_3s_4s_and_6s_are_zero: -> void
  def test_score_of_a_triple_1_is_1000: -> void
  def test_score_of_other_triples_is_100x: -> void
  def test_score_of_mixed_is_sum: -> void
end
