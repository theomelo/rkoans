module Exercises
  class AboutBlocks
    type answers = {
      methods_can_take_blocks_one: (::Integer | :fill_me_in),
      blocks_can_be_defined_with_do_end_too_one: (::Integer | :fill_me_in),
      blocks_can_take_arguments_one: (::String | :fill_me_in),
      methods_can_call_yield_many_times_one: (::Array[::Symbol] | :fill_me_in),
      methods_can_see_if_they_have_been_called_with_a_block_one: (::Symbol | :fill_me_in),
      methods_can_see_if_they_have_been_called_with_a_block_two: (::Symbol | :fill_me_in),
      block_can_affect_variables_in_the_code_where_they_are_created_one: (::Symbol | :fill_me_in),
      blocks_can_be_assigned_to_variables_and_called_explicitly_one: (::Integer | :fill_me_in),
      blocks_can_be_assigned_to_variables_and_called_explicitly_two: (::Integer | :fill_me_in),
      stand_alone_blocks_can_be_passed_to_methods_expecting_blocks_one: (::String | :fill_me_in),
      methods_can_take_an_explicit_block_argument_one: (::Integer | :fill_me_in),
      methods_can_take_an_explicit_block_argument_two: (::Integer | :fill_me_in)
    }
    def self.koans: -> answers
  end
end

class AboutBlocksTest
  def method_with_block: [A] () { () -> A } -> A
  def test_methods_can_take_blocks: -> void
  def test_blocks_can_be_defined_with_do_end_too: -> void
  def method_with_block_arguments: [A] () { (String) -> A } -> A
  def test_blocks_can_take_arguments: -> void
  def many_yields: [A] () { (Symbol) -> A } -> A
  def test_methods_can_call_yield_many_times: -> void
  def yield_tester: [A] () ?{ () -> A } -> (A | Symbol)
  def test_methods_can_see_if_they_have_been_called_with_a_block: -> void
  def test_block_can_affect_variables_in_the_code_where_they_are_created: -> void
  def test_blocks_can_be_assigned_to_variables_and_called_explicitly: -> void
  def test_stand_alone_blocks_can_be_passed_to_methods_expecting_blocks: -> void
  def method_with_explicit_block: [A] () { (Integer) -> A } -> A
  def test_methods_can_take_an_explicit_block_argument: -> void
end
