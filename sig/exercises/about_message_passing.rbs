module Exercises
  class AboutMessagePassing
    type answers = {
      methods_can_be_invoked_more_dynamically_one: (bool | :fill_me_in),
      methods_can_be_invoked_more_dynamically_two: (bool | :fill_me_in),
      send_with_underscores_will_also_send_messages_one: (bool | :fill_me_in),
      classes_can_be_asked_if_they_know_how_to_respond_one: (bool | :fill_me_in),
      classes_can_be_asked_if_they_know_how_to_respond_two: (bool | :fill_me_in),
      sending_a_message_with_arguments_one: (::Array[untyped] | :fill_me_in),
      sending_a_message_with_arguments_two: (::Array[untyped] | :fill_me_in),
      sending_a_message_with_arguments_three: (::Array[::Integer | nil] | :fill_me_in),
      sending_a_message_with_arguments_four: (::Array[::Integer | nil] | :fill_me_in),
      sending_undefined_messages_to_a_typical_object_results_in_errors_one: (singleton(::NoMethodError) | :fill_me_in),
      calling_method_missing_causes_the_no_method_error_one: (singleton(::NoMethodError) | :fill_me_in),
      all_messages_are_caught_one: (::String | :fill_me_in),
      all_messages_are_caught_two: (::String | :fill_me_in),
      all_messages_are_caught_three: (::String | :fill_me_in),
      catching_messages_makes_respond_to_lie_one: (bool | :fill_me_in),
      foo_method_are_caught_one: (::String | :fill_me_in),
      foo_method_are_caught_two: (::String | :fill_me_in),
      non_foo_messages_are_treated_normally_one: (singleton(::NoMethodError) | :fill_me_in),
      explicitly_implementing_respond_to_lets_objects_tell_the_truth_one: (bool | :fill_me_in),
      explicitly_implementing_respond_to_lets_objects_tell_the_truth_two: (bool | :fill_me_in)
    }
    def self.koans: -> answers
  end
end

class AboutMessagePassingTest
  def test_methods_can_be_called_directly: -> void
  def test_methods_can_be_invoked_by_sending_the_message: -> void
  def test_methods_can_be_invoked_more_dynamically: -> void
  def test_send_with_underscores_will_also_send_messages: -> void
  def test_classes_can_be_asked_if_they_know_how_to_respond: -> void
  def test_sending_a_message_with_arguments: -> void
  def test_sending_undefined_messages_to_a_typical_object_results_in_errors: -> void
  def test_calling_method_missing_causes_the_no_method_error: -> void
  def test_all_messages_are_caught: -> void
  def test_catching_messages_makes_respond_to_lie: -> void
  def test_foo_method_are_caught: -> void
  def test_non_foo_messages_are_treated_normally: -> void
  def test_explicitly_implementing_respond_to_lets_objects_tell_the_truth: -> void
  def assert_predicted_error: (::Symbol key, singleton(::Exception) klass) { () -> untyped } -> ::Exception
end

class AboutMessagePassingTest::MessageCatcher
  def caught?: () -> bool
  def add_a_payload: [A] (*A args) -> Array[A]
end

class AboutMessagePassingTest::TypicalObject

end

class AboutMessagePassingTest::AllMessageCatcher
  def method_missing: (Symbol method_name, *untyped args) ?{ (*untyped) -> untyped } -> String
end

class AboutMessagePassingTest::WellBehavedFooCatcher
  def method_missing: (Symbol method_name, *untyped args) ?{ (*untyped) -> untyped } -> String
  private
  def respond_to_missing?: (Symbol | String method_name, ?bool include_private) -> bool
  public
end
