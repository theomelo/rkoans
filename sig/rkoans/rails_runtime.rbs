module Rkoans
  class RailsRuntime
    @boundary: String
    @directory: String
    @manifest: String
    def self.for_workspace: (String directory) -> RailsRuntime
    def initialize: (?directory: String?, ?root: String, ?boundary: String?) -> void
    def setup: (?out: (IO | StringIO)) -> Integer
    def ready?: -> bool
    def command: (Exercise exercise) -> Array[String]
    def environment: -> Hash[String, String?]
    private
    def setup_paths: -> Array[String]
    def validate_setup_paths: -> void
    def bundler_command: (String operation) -> Array[String]
  end
end
