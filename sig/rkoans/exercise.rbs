module Rkoans
  class Exercise
    @id: String
    @solution: String
    @source: String
    @root: String

    attr_reader solution: String
    attr_reader id: String

    def initialize: (?directory: String, ?id: String, ?catalog: Catalog) -> void
    def prepare: -> Integer?
    def instructions: -> String
    def checks: -> String
    def reference: -> String
    def hint: -> String
  end
end
