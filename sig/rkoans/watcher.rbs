module Rkoans
  class Watcher
    @paths: Array[String]
    @interval: Float
    @debounce: Float
    @previous: Array[String?]
    @changed_at: Float?

    def initialize: (String | Array[String] path, ?interval: Float, ?debounce: Float) -> void
    def run: (?input: IO?) { (String?) -> untyped } -> bot

    private

    def fingerprint: -> Array[String?]
    def changed?: -> bool
    def monotonic_time: -> Float
  end
end
